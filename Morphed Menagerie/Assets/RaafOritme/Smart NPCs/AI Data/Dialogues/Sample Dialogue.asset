  m_Name: Sample Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::RaafOritme.SmartNPCs.DialogueSO
  agentName: Citizen
  dialogue:
    text: Good day!
    answers:
    - answer: Hello.
      linksTo:
        text: How are you doing?
        answers:
        - answer: Fine, and you?
          linksTo:
            text: Great, are you enjoying the demo?
            answers:
            - answer: I do!
              linksTo:
                text: I am so happy to read that! Did you know that you can enter
                  as much text as you want and it adapts dynamically?
                answers:
                - answer: This supports up to 3 answers.
                  linksTo:
                    text: 
                    answers: []
                  end: 1
                - answer: It can nest as far as you want.
                  linksTo:
                    text: 
                    answers: []
                  end: 1
                - answer: This for example continues the conversation.
                  linksTo:
                    text: It can go as crazy as you want!
                    answers:
                    - answer: Thank you!
                      linksTo:
                        text: 
                      end: 1
                  end: 0
              end: 0
          end: 0
        - answer: Bad, good bye.
          linksTo:
            text: 
            answers: []
          end: 1
      end: 0
    - answer: Good bye.
      linksTo:
        text: 
        answers: []
      end: 1
